# Rust build output
/target
**/*.rs.bk

# Runtime state: database, master key, logs. Never commit any of this.
/data
*.key
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Local environment
.env
.env.*
!.env.example

# Recorded manufacturer responses before anonymisation
/fixtures/**/raw/

# Raw manufacturer exports dropped into the repository root (they carry the real VIN and user id)
/*.json
/*.zip

# Project planning and agent instructions stay local; they are not published
/Docs/
/CLAUDE.md
/AGENTS.md

# Editors and operating systems
.idea/
*.swp
.DS_Store
Thumbs.db
